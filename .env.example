# Copy this file to .env.local and fill in your Firebase project's values.
# Find these under Firebase Console > Project Settings > General > Your apps > SDK setup and configuration.
# .env.local is gitignored — never commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Only needed if you're using a named (non-default) Firestore database.
# Leave blank to use the default database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
