rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Data Model
    // ===============================================================
    //
    // events                 - workshop/event records, owned by createdBy
    // submissions             - anonymous participant "expectations", public read
    // tests                   - pre/post-test definitions, owned by createdBy
    // test_questions          - questions belonging to a test
    // test_submissions        - a participant's attempt at a test
    // test_submission_answers - individual answers within an attempt
    // users                   - profile + role ('admin' | unset == facilitator)
    //
    // Note on assessment integrity: test_questions (including correctAnswer /
    // rubric) is currently readable by anyone with the test ID, and objective
    // scoring runs client-side. This is fine for low-stakes / informal
    // pre-post knowledge checks, but a participant with developer tools could
    // technically see answer keys before submitting. Closing that fully
    // requires moving scoring to a server-side Cloud Function and splitting
    // answer keys into a non-public collection. Flagged in DEPLOYMENT.md as a
    // recommended Phase 2 hardening step.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Walks test_submission_answers -> test_submissions -> tests to confirm
    // the caller owns the parent test (used for review/scoring access).
    function ownsTestViaSubmission(submissionId) {
      let sub = get(/databases/$(database)/documents/test_submissions/$(submissionId));
      let test = get(/databases/$(database)/documents/tests/$(sub.data.testId));
      return isAuthenticated() && test.data.createdBy == request.auth.uid;
    }

    function ownsTestViaQuestion() {
      let test = get(/databases/$(database)/documents/tests/$(resource.data.testId));
      return isAuthenticated() && test.data.createdBy == request.auth.uid;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'eventCode', 'slug', 'status', 'createdBy', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.eventCode is string && data.eventCode.size() == 6 &&
             data.slug is string && data.slug.size() > 0 &&
             data.status in ['active', 'closed'] &&
             data.createdBy == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidSubmission(data) {
      let requiredFields = ['eventId', 'expectation', 'createdAt'];
      let allowedFields = ['eventId', 'expectation', 'createdAt', 'participantId', 'category'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.eventId is string &&
             data.expectation is string && data.expectation.size() > 0 && data.expectation.size() <= 500 &&
             data.createdAt is timestamp &&
             (!('participantId' in data) || (data.participantId is string && (request.auth == null || data.participantId == request.auth.uid))) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    function isValidTest(data) {
      let requiredFields = ['eventId', 'type', 'title', 'status', 'scoringMode', 'createdBy', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.eventId is string &&
             data.type in ['pre_test', 'post_test'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status in ['draft', 'live', 'closed'] &&
             data.scoringMode in ['auto', 'ai', 'hybrid'] &&
             data.createdBy == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidQuestion(data) {
      let requiredFields = ['testId', 'type', 'text', 'weight', 'orderIndex'];
      return data.keys().hasAll(requiredFields) &&
             data.testId is string &&
             data.type in ['multiple_choice', 'multiple_select', 'short_answer', 'paragraph', 'true_false'] &&
             data.text is string && data.text.size() > 0 &&
             data.weight is number && data.weight >= 0 &&
             data.orderIndex is number;
    }

    function isValidTestSubmission(data) {
      let requiredFields = ['testId', 'participantName', 'accessToken', 'startedAt', 'status'];
      return data.keys().hasAll(requiredFields) &&
             data.testId is string &&
             data.participantName is string && data.participantName.size() > 0 &&
             data.accessToken is string &&
             data.startedAt is timestamp &&
             data.status in ['started', 'submitted'];
    }

    function isValidTestSubmissionAnswer(data) {
      let requiredFields = ['submissionId', 'questionId'];
      return data.keys().hasAll(requiredFields) &&
             data.submissionId is string &&
             data.questionId is string &&
             (!('answerText' in data) || (data.answerText is string && data.answerText.size() <= 5000)) &&
             (!('awardedScore' in data) || data.awardedScore is number);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidEvent(request.resource.data);
      allow update: if isAuthenticated() && isDocOwner() && isValidEvent(request.resource.data);
      allow delete: if isAuthenticated() && isDocOwner();
    }

    match /submissions/{submissionId} {
      allow read: if true; // Powers the public live-wall display
      allow create: if isValidSubmission(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() && (isOwner(resource.data.participantId) || isAdmin());
    }

    match /tests/{testId} {
      allow read: if true; // Needed so participants can load a live test by ID
      allow create: if isAuthenticated() && isValidTest(request.resource.data);
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid && isValidTest(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /test_questions/{questionId} {
      allow read: if true; // Needed so participants can load questions for a live test
      allow create: if isAuthenticated() && isValidQuestion(request.resource.data);
      // FIXED: previously any signed-in user (not just the test's owner) could
      // edit or delete another facilitator's questions.
      allow update: if isAuthenticated() && ownsTestViaQuestion() && isValidQuestion(request.resource.data);
      allow delete: if isAuthenticated() && ownsTestViaQuestion();
    }

    match /test_submissions/{submissionId} {
      // FIXED: previously any unauthenticated visitor could read every
      // participant's name/org/score across all events. Participants never
      // read this collection back in the app, so it's now owner/admin only.
      allow read: if isAuthenticated() && (isAdmin() || get(/databases/$(database)/documents/tests/$(resource.data.testId)).data.createdBy == request.auth.uid);
      allow create: if isValidTestSubmission(request.resource.data);
      // Anonymous test-takers never get a Firebase Auth session today, so the
      // app immediately self-updates totalScore right after creating the
      // submission. That narrow anonymous path is preserved; everything else
      // requires ownership/admin.
      allow update: if (isAuthenticated() && (isAdmin() || get(/databases/$(database)/documents/tests/$(resource.data.testId)).data.createdBy == request.auth.uid)) ||
                     (request.auth == null && resource.data.accessToken == request.resource.data.accessToken && isValidTestSubmission(request.resource.data));
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /test_submission_answers/{answerId} {
      // FIXED: previously public/unauthenticated read of all answers.
      allow read: if isAuthenticated() && (isAdmin() || ownsTestViaSubmission(resource.data.submissionId));
      // Anonymous participants create answers as they take a test; no auth
      // session exists for them today (see note above).
      allow create: if isValidTestSubmissionAnswer(request.resource.data);
      // FIXED: this was `isAuthenticated() || true`, which evaluates to
      // always-true — anyone, signed in or not, could rewrite any
      // participant's score. Now restricted to the test's owner or an admin.
      allow update: if isAuthenticated() && (isAdmin() || ownsTestViaSubmission(resource.data.submissionId));
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /users/{userId} {
      // Anyone can read/write their own profile, but NOT their own role —
      // role changes must come from an existing admin (or the one-time
      // console bootstrap described in DEPLOYMENT.md).
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && !('role' in request.resource.data);
      allow update: if isAdmin() ||
                     (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
  }
}
