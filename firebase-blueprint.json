{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "A workshop or peacebuilding event.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the event." },
        "description": { "type": "string", "description": "A brief description of the event." },
        "eventCode": { "type": "string", "description": "A unique 6-character code for participants to join." },
        "slug": { "type": "string", "description": "A URL-friendly version of the title." },
        "status": { "type": "string", "enum": ["active", "closed"], "description": "The current status of the event." },
        "createdBy": { "type": "string", "description": "The UID of the facilitator who created the event." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the event was created." }
      },
      "required": ["title", "eventCode", "slug", "status", "createdBy", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A participant's expectation submission.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "description": "The ID of the event this submission belongs to." },
        "expectation": { "type": "string", "description": "The content of the expectation." },
        "category": { "type": "string", "description": "An optional category for the expectation." },
        "participantId": { "type": "string", "description": "An anonymous ID for the participant." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the submission was made." }
      },
      "required": ["eventId", "expectation", "createdAt"]
    },
    "Test": {
      "title": "Test",
      "description": "A pre-test or post-test linked to an event.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "description": "The ID of the event this test belongs to." },
        "type": { "type": "string", "enum": ["pre_test", "post_test"], "description": "The type of test." },
        "title": { "type": "string", "description": "The title of the test." },
        "instructions": { "type": "string", "description": "Short instructions for the test." },
        "status": { "type": "string", "enum": ["draft", "live", "closed"], "description": "The current status of the test." },
        "scoringMode": { "type": "string", "enum": ["auto", "ai", "hybrid"], "description": "How the test is scored." },
        "passMark": { "type": "number", "description": "The minimum score to pass the test." },
        "createdBy": { "type": "string", "description": "The UID of the facilitator who created the test." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the test was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the test was last updated." }
      },
      "required": ["eventId", "type", "title", "status", "scoringMode", "createdBy", "createdAt"]
    },
    "TestQuestion": {
      "title": "TestQuestion",
      "description": "A question within a test.",
      "type": "object",
      "properties": {
        "testId": { "type": "string", "description": "The ID of the test this question belongs to." },
        "type": { "type": "string", "enum": ["multiple_choice", "multiple_select", "short_answer", "paragraph", "true_false"], "description": "The type of question." },
        "text": { "type": "string", "description": "The question text." },
        "helpText": { "type": "string", "description": "Optional description/help text." },
        "isRequired": { "type": "boolean", "description": "Whether the question is mandatory." },
        "weight": { "type": "number", "description": "The score value/weight of the question." },
        "orderIndex": { "type": "number", "description": "The position of the question in the test." },
        "correctAnswer": { "type": "any", "description": "The correct answer or answer key." },
        "acceptableAnswers": { "type": "array", "items": { "type": "string" }, "description": "Acceptable alternative answers." },
        "rubric": { "type": "string", "description": "Marking guide or rubric for open-ended answers." }
      },
      "required": ["testId", "type", "text", "weight", "orderIndex"]
    },
    "TestSubmission": {
      "title": "TestSubmission",
      "description": "A participant's submission for a test.",
      "type": "object",
      "properties": {
        "testId": { "type": "string", "description": "The ID of the test." },
        "participantName": { "type": "string", "description": "The name of the participant." },
        "organization": { "type": "string", "description": "The organization or community." },
        "role": { "type": "string", "description": "The role of the participant." },
        "accessToken": { "type": "string", "description": "A unique token for the participant to retrieve their submission." },
        "startedAt": { "type": "string", "format": "date-time", "description": "When the participant started the test." },
        "submittedAt": { "type": "string", "format": "date-time", "description": "When the participant submitted the test." },
        "status": { "type": "string", "enum": ["started", "submitted"], "description": "The current status of the submission." },
        "totalScore": { "type": "number", "description": "The total score awarded." },
        "aiScoreStatus": { "type": "string", "enum": ["pending", "completed", "failed"], "description": "The status of AI scoring." },
        "requiresManualReview": { "type": "boolean", "description": "Whether the submission needs manual review." }
      },
      "required": ["testId", "participantName", "accessToken", "startedAt", "status"]
    },
    "TestSubmissionAnswer": {
      "title": "TestSubmissionAnswer",
      "description": "An answer to a specific question in a test submission.",
      "type": "object",
      "properties": {
        "submissionId": { "type": "string", "description": "The ID of the test submission." },
        "questionId": { "type": "string", "description": "The ID of the question." },
        "answerText": { "type": "string", "description": "The text answer for short/paragraph questions." },
        "selectedOptions": { "type": "array", "items": { "type": "string" }, "description": "Selected options for multiple choice/select." },
        "awardedScore": { "type": "number", "description": "The score awarded for this answer." },
        "aiFeedback": { "type": "string", "description": "Feedback provided by the AI." },
        "confidenceScore": { "type": "number", "description": "The AI's confidence in the score." },
        "finalReviewedScore": { "type": "number", "description": "The final score after manual review." },
        "finalReviewStatus": { "type": "string", "enum": ["pending", "approved"], "description": "The status of the manual review." }
      },
      "required": ["submissionId", "questionId"]
    }
  },
  "firestore": {
    "/events": {
      "schema": "Event",
      "description": "Collection of workshop events."
    },
    "/submissions": {
      "schema": "Submission",
      "description": "Collection of participant submissions."
    },
    "/tests": {
      "schema": "Test",
      "description": "Collection of pre-tests and post-tests."
    },
    "/test_questions": {
      "schema": "TestQuestion",
      "description": "Collection of test questions."
    },
    "/test_submissions": {
      "schema": "TestSubmission",
      "description": "Collection of test submissions."
    },
    "/test_submission_answers": {
      "schema": "TestSubmissionAnswer",
      "description": "Collection of answers within test submissions."
    }
  }
}
